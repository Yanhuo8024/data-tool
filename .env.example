# ==================== data.tool 环境变量模板 ====================
# 复制为 .env 并填入真实值；切勿将 .env 提交到版本库。

# ---- 安全（强烈建议生产环境设置） ----
# SECRET_KEY: Flask/JWT 签名密钥。不设置时应用会自动生成并持久化到 data/secret.key。
# SECRET_KEY=please-change-me-to-a-long-random-string
# ADMIN_PASSWORD: 首次启动创建默认管理员 admin 的密码。
#                 不设置时将生成随机密码并打印到控制台（请登录后立即修改）。
# ADMIN_PASSWORD=change-me-please

# ---- 服务器 ----
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# FLASK_DEBUG=0

# ---- 金融数据源 Token（可选，用于 tushare 等） ----
# TUSHARE_TOKEN=

# ---- LLM API Key（可选，用于 AI 助手/智能体） ----
# 推荐方式：将 Key 写入加密凭据库（Fernet/AES，密钥源自 data/secret.key）：
#   python -c "from secure_config import set_llm_api_key; set_llm_api_key('sensenova', 'sk-...')"
# 其次才是本文件的明文环境变量；最后兜底前端传入。
# SENSENOVA_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# 可选：按 provider 覆盖默认模型，如 DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL=
# OPENAI_MODEL=
# OLLAMA_MODEL=qwen2.5:7b

# ---- 提示词版本化（可选） ----
# 默认提示词内置在 prompts.py；如需热更新，用 set_prompt 或直接编辑
# data/prompt_versions.json（无需改代码即可覆盖 Agent 系统提示等）
